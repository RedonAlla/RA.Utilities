<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<Version>10.1.0</Version>
		<Title>Message Dispatching</Title>
		<Description>Provides a lightweight, source-generated mediator (dispatcher) for CQRS, including Result-based request and notification dispatch, pipeline behaviors, validation, and automatic handler registration.</Description>
		<PackageTags>RA;Utilities;Dispatcher;CQRS;Mediator;Vertical Slice</PackageTags>
		<PackageIcon>dispatch.png</PackageIcon>
		<PackageId>RA.Utilities.Dispatcher</PackageId>
		<PackageReleaseNotesFile>releasenotes.md</PackageReleaseNotesFile>
    <AssemblyTitle>RA.Utilities.Dispatcher</AssemblyTitle>
	</PropertyGroup>

  <ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="../../Assets/Images/dispatch.png" Pack="true" PackagePath="\" />
		<None Include="releasenotes.md" Pack="true" PackagePath="\" />
	</ItemGroup>

  <!-- Referenced for build ordering and packing only, deliberately NOT as an analyzer:
       running the generator on this package's own compilation would auto-register the
       package's own abstract bases and behaviors and emit a self-referential initializer. -->
  <ItemGroup>
    <ProjectReference Include="../RA.Utilities.Dispatcher.Generators/RA.Utilities.Dispatcher.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0" />

    <!-- Ships the source generator inside the package so consumers get it as a build-time analyzer. -->
    <None Include="../RA.Utilities.Dispatcher.Generators/bin/$(Configuration)/netstandard2.0/RA.Utilities.Dispatcher.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RA.Utilities.Application.Validation/RA.Utilities.Application.Validation.csproj" />
    <ProjectReference Include="../../Core/RA.Utilities.Core.Results/RA.Utilities.Core.Results.csproj" />
  </ItemGroup>

</Project>
