<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <NoWarn>$(NoWarn);CS1591;CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RA.Utilities.Feature/RA.Utilities.Feature.csproj" />
    <!-- Referencing the generator as an analyzer makes this assembly's handlers auto-register. -->
    <ProjectReference Include="../RA.Utilities.Feature.Generators/RA.Utilities.Feature.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
