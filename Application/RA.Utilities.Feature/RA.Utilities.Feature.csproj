<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<Version>10.2.0</Version>
		<Title>Feature Management</Title>
		<Description>Provides a base implementation for the feature slice/vertical slice architecture pattern, including base handlers, validation behaviors, and exception handling for CQRS.</Description>
		<PackageTags>RA;Utilities;Feature;CQRS;Mediator;Vertical Slice</PackageTags>
		<PackageIcon>mediator.png</PackageIcon>
		<PackageId>RA.Utilities.Feature</PackageId>
		<PackageReleaseNotesFile>releasenotes.md</PackageReleaseNotesFile>
    <AssemblyTitle>RA.Utilities.Feature</AssemblyTitle>
	</PropertyGroup>

  <ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="../../Assets/Images/mediator.png" Pack="true" PackagePath="\" />
		<None Include="releasenotes.md" Pack="true" PackagePath="\" />
	</ItemGroup>

  <!-- Referenced for build ordering and packing only, deliberately NOT as an analyzer:
       running the generator on this package's own compilation would auto-register the
       package's own abstract bases and behaviors and emit a self-referential initializer. -->
  <ItemGroup>
    <ProjectReference Include="../RA.Utilities.Feature.Generators/RA.Utilities.Feature.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0" />

    <!-- Ships the source generator inside the package so consumers get it as a build-time analyzer. -->
    <None Include="../RA.Utilities.Feature.Generators/bin/$(Configuration)/netstandard2.0/RA.Utilities.Feature.Generators.dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs/"
          Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../RA.Utilities.Application.Validation/RA.Utilities.Application.Validation.csproj" />
  </ItemGroup>

</Project>
