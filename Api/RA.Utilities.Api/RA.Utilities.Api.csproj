<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<Version>10.2.0</Version>
		<Title>Api Utilities</Title>
		<Description>Provides a collection of essential utilities for building robust and consistent ASP.NET Core APIs. This package includes endpoint registration helpers, standardized response models, and exception handling middleware to streamline development and promote best practices.</Description>
		<PackageTags>RA;Utilities;API;Web;AspNetCore;Endpoints;Helpers;Middleware;Exceptions;Responses;Standardization</PackageTags>
		<PackageIcon>api.png</PackageIcon>
		<PackageId>RA.Utilities.Api</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotesFile>releasenotes.md</PackageReleaseNotesFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="../../Assets/Images/api.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="releasenotes.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../RA.Utilities.Api.Response/RA.Utilities.Api.Response.csproj" />
		<ProjectReference Include="../../Core/RA.Utilities.Core.Constants/RA.Utilities.Core.Constants.csproj" />
		<ProjectReference Include="../../Core/RA.Utilities.Core.Exceptions/RA.Utilities.Core.Exceptions.csproj" />
		<ProjectReference Include="../../Logging/RA.Utilities.Logging.Shared/RA.Utilities.Logging.Shared.csproj" />
		<!-- Referenced for build ordering and packing only, deliberately NOT as an analyzer:
		     running the generator on this package's own compilation would emit a second,
		     empty MapEndpoints method into the RA.Utilities.Api assembly, making extension
		     method calls ambiguous in consuming projects (which get their own generated
		     implementation). -->
		<ProjectReference Include="../RA.Utilities.Api.Generators/RA.Utilities.Api.Generators.csproj"
		                  ReferenceOutputAssembly="false"
		                  SetTargetFramework="TargetFramework=netstandard2.0" />

		<!-- Ships the source generator inside the package so that consumers of the NuGet package
		     get it as a build-time analyzer. -->
		<None Include="../RA.Utilities.Api.Generators/bin/$(Configuration)/netstandard2.0/RA.Utilities.Api.Generators.dll"
		      Pack="true"
		      PackagePath="analyzers/dotnet/cs/"
		      Visible="false" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="EndpointFilters/" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="FluentValidation" />
	</ItemGroup>
	
</Project>