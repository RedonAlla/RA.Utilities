<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS1591;CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Api/RA.Utilities.Api/RA.Utilities.Api.csproj" />
    <ProjectReference Include="../../Api/RA.Utilities.Api.Response/RA.Utilities.Api.Response.csproj" />
    <ProjectReference Include="../../Api/RA.Utilities.Authentication.JwtBearer/RA.Utilities.Authentication.JwtBearer.csproj" />
    <ProjectReference Include="../../Api/RA.Utilities.OpenApi/RA.Utilities.OpenApi.csproj" />
    <ProjectReference Include="../../Core/RA.Utilities.Core.Exceptions/RA.Utilities.Core.Exceptions.csproj" />
    <ProjectReference Include="../../Core/RA.Utilities.Core.Results/RA.Utilities.Core.Results.csproj" />
    <ProjectReference Include="../../Core/RA.Utilities.Core.ValueObjects/RA.Utilities.Core.ValueObjects.csproj" />
    <ProjectReference Include="../../Application/RA.Utilities.Feature/RA.Utilities.Feature.csproj" />
    <ProjectReference Include="../../Application/RA.Utilities.Application.Validation/RA.Utilities.Application.Validation.csproj" />
  </ItemGroup>

  <!-- The handler registration generator is referenced twice: normally so tests can drive it
       in-memory, and as an analyzer so the test assembly's own handlers are auto-registered. -->
  <ItemGroup>
    <ProjectReference Include="../../Application/RA.Utilities.Feature.Generators/RA.Utilities.Feature.Generators.csproj"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
    <ProjectReference Include="../../Application/RA.Utilities.Feature.Generators/RA.Utilities.Feature.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
