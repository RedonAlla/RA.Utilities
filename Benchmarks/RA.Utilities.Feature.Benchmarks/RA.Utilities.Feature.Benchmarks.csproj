<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- The global GenerateDocumentationFile=True would otherwise fail undocumented public
         benchmark classes with CS1591 under TreatWarningsAsErrors. BDN1605 is BenchmarkDotNet's
         informational async-benchmark suggestion; preemptively silenced to keep output clean.
         The benchmark handlers are generic and registered explicitly, so the source generator
         reports FEAG002 (generic handler) and FEAG007 (no discoverable handler) — both expected
         here. -->
    <NoWarn>$(NoWarn);CS1591;BDN1605;FEAG002;FEAG007;FEAG010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="MediatR" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Application/RA.Utilities.Feature/RA.Utilities.Feature.csproj" />
    <!-- Referencing the generator as an analyzer generates the MediatorImpl in this assembly, so
         the generated-mediator benchmarks exercise the monomorphized dispatch. -->
    <ProjectReference Include="../../Application/RA.Utilities.Feature.Generators/RA.Utilities.Feature.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      SetTargetFramework="TargetFramework=netstandard2.0" />
  </ItemGroup>

</Project>
