<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
		<Version>10.0.2</Version>
    <Title>RA Utilities Core Constants</Title>
		<Description>Provides a centralized and consistent set of core constants for the RA.Utilities ecosystem, including response types, HTTP status codes, default response messages, and standard HTTP header names. Shared by the other RA.Utilities packages to eliminate magic strings and promote consistency, with zero dependencies.</Description>
		<PackageTags>RA;Utilities;Core;Constants;HTTP;StatusCodes;Responses;Messages;Headers</PackageTags>
		<PackageIcon>constant.png</PackageIcon>
		<PackageId>RA.Utilities.Core.Constants</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageReleaseNotesFile>releasenotes.md</PackageReleaseNotesFile>
	</PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RA.Utilities.Tests" />
  </ItemGroup>

  <ItemGroup>
		<None Include="../../Assets/Images/constant.png" Pack="true" PackagePath="\" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="releasenotes.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
